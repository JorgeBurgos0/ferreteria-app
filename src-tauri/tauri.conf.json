{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferretería App",
  "version": "0.1.0",
  "identifier": "io.github.jorgeburgos0.ferreteria",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ferretería App",
        "width": 1200,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset: http://asset.localhost",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      },
      "devCsp": {
        "default-src": "'self' asset: http://asset.localhost",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Jorge Burgos",
    "category": "Business",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "linux": {
      "rpm": {
        "files": {
          "/usr/share/licenses/ferreteria-app/LICENSE": "../LICENSE"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "dialog": null
  }
}
